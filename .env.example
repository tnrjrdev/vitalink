# ===========================================================================
# Variaveis de ambiente da Plataforma Medico
# Copie para um arquivo .env (NUNCA versionar o .env real) e ajuste os valores.
# Consumido pelo docker-compose.yml e pela aplicacao Spring Boot.
# ===========================================================================

# --- Banco de dados PostgreSQL ---
POSTGRES_DB=medico
POSTGRES_USER=medico
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Aplicacao ---
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080

# --- Seguranca / JWT ---
# A chave DEVE ter no minimo 64 caracteres (HMAC-SHA512). Gere uma aleatoria:
#   openssl rand -base64 64
APP_JWT_SECRET=troque-esta-chave-secreta-por-uma-string-aleatoria-de-no-minimo-64-bytes-em-base64
APP_JWT_ACCESS_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_ISSUER=medico-platform

# --- Usuario administrador inicial (seed) ---
APP_ADMIN_EMAIL=admin@medico.com
APP_ADMIN_PASSWORD=ChangeMe@123
