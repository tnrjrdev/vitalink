# Copie para um arquivo .env (NUNCA versionar o .env real)
POSTGRES_DB=medico
POSTGRES_USER=medico
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080

# Chave secreta de no minimo 64 caracteres (Gere com: openssl rand -base64 64)
APP_JWT_SECRET=troque-esta-chave-secreta-por-uma-string-aleatoria-de-no-minimo-64-bytes-em-base64
APP_JWT_ACCESS_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_ISSUER=medico-platform

APP_ADMIN_EMAIL=admin@medico.com
APP_ADMIN_PASSWORD=ChangeMe@123

# ===========================================================================
# Integracao AWS (opcional). Deixe APP_AWS_ENABLED=false para rodar sem AWS
# (usa armazenamento local + logs no lugar de S3/SES/SNS).
# ===========================================================================
APP_AWS_ENABLED=false
APP_AWS_REGION=us-east-1
# Em producao prefira IAM Role (deixe as chaves em branco). Para testes locais:
APP_AWS_ACCESS_KEY=
APP_AWS_SECRET_KEY=

# S3 - documentos clinicos
APP_AWS_S3_BUCKET=vitalink-documents
APP_AWS_S3_PRESIGN_MINUTES=15

# SES - e-mails transacionais (remetente precisa estar verificado no SES)
APP_AWS_SES_FROM=no-reply@vitalink.com

# SNS - topico de eventos de consulta
APP_AWS_SNS_APPOINTMENT_TOPIC_ARN=

# SQS - consumidor dos eventos (fan-out SNS -> SQS)
APP_AWS_SQS_CONSUMER_ENABLED=false
APP_AWS_SQS_APPOINTMENT_QUEUE_URL=

# Secrets Manager / SSM - carregamento de segredos no boot (opcional)
APP_AWS_SECRETS_ENABLED=false
APP_AWS_SECRET_NAME=
APP_AWS_SSM_ENABLED=false
APP_AWS_SSM_PARAMETER_PATH=

# Limites de upload (multipart)
APP_MAX_FILE_SIZE=10MB
APP_MAX_REQUEST_SIZE=15MB
