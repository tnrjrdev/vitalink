  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar (paciente/profissional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Maria Profissional\",\n  \"email\": \"maria.prof@vitalink.com\",\n  \"password\": \"Senha123\",\n  \"roles\": [\n    \"ROLE_PROFESSIONAL\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Auto-registro. So aceita ROLE_PATIENT ou ROLE_PROFESSIONAL (ROLE_ADMIN retorna 422)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "if (r.accessToken) { pm.collectionVariables.set('selfToken', r.accessToken); }",
                  "console.log('Registrado. (use Login admin para os endpoints administrativos)');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medico.com\",\n  \"password\": \"ChangeMe@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Autentica o admin (criado no boot) e salva {{token}} e {{refreshToken}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "console.log('Token salvo. Perfis: ' + r.roles);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Renova o access token a partir do refresh token salvo."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "console.log('Token salvo. Perfis: ' + r.roles);"
                ]
              }
            }
          ]
        }
      ]
    },
