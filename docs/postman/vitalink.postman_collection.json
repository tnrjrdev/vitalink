                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "appointments"
              ]
            },
            "description": "Datas calculadas para +7 dias (pre-request). Salva {{appointmentId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var start = new Date(Date.now() + 7*24*60*60*1000);",
                  "start.setSeconds(0,0);",
                  "var end = new Date(start.getTime() + 30*60*1000);",
                  "pm.collectionVariables.set('scheduledStart', start.toISOString());",
                  "pm.collectionVariables.set('scheduledEnd', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
